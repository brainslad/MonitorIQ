# /etc/monitoriq/monitoriq.env — MonitorIQ configuration
# After changing: systemctl restart monitoriq

# PostgreSQL connection
MONITORIQ_DATABASE_URL=postgres://monitoriq:CHANGE_ME@127.0.0.1:5432/monitoriq?sslmode=disable

# Address and port the web server listens on.
# Use 127.0.0.1:8080 when running behind a reverse proxy (nginx).
MONITORIQ_LISTEN=0.0.0.0:8080

# Public URL (used in status page links), e.g. https://status.example.com
MONITORIQ_BASE_URL=

# Behind a reverse proxy that sets X-Forwarded-For/Proto: the proxy's address
# or network (e.g. 10.0.0.5 or 10.0.0.0/24, comma separated), so only requests
# from it are believed. true trusts any sender: use it only when MonitorIQ
# listens on 127.0.0.1.
MONITORIQ_TRUST_PROXY=false

# HTTPS-only cookies. Left unset, they are decided per request: Secure when the
# browser comes in over HTTPS (directly, through a trusted proxy, or on the host
# of an https:// BASE_URL), ordinary on plain HTTP such as http://<ip>:8080.
# Set true or false to force it.
#MONITORIQ_COOKIE_SECURE=true

# Key that encrypts 2FA secrets and the LDAP / SSO credentials stored in the
# database. Generate one with: openssl rand -base64 48
# Keep it safe and never change it: changing it disables everyone's 2FA
# (reset with "monitoriq user reset-2fa <user>") and the saved LDAP/SSO secrets.
# When empty, a key is created in $MONITORIQ_DATA_DIR/secret.key.
MONITORIQ_SECRET_KEY=

# Directory for the generated key file (systemd StateDirectory)
#MONITORIQ_DATA_DIR=/var/lib/monitoriq

# Maximum number of concurrent checks
MONITORIQ_MAX_CONCURRENCY=50

# Geolocation databases for the network map (city.mmdb, asn.mmdb).
# Download them under Settings → Geolocation or with "monitoriq geoip update".
#MONITORIQ_GEOIP_DIR=/var/lib/monitoriq/geoip

# 1 to log every HTTP request to the journal
#MONITORIQ_DEBUG=1
