# /etc/monitoriq/monitoriq.env — MonitorIQ configuration
# After changing: systemctl restart monitoriq

# PostgreSQL connection
MONITORIQ_DATABASE_URL=postgres://monitoriq:CHANGE_ME@127.0.0.1:5432/monitoriq?sslmode=disable

# Address and port the web server listens on.
# Use 127.0.0.1:8080 when running behind a reverse proxy (nginx).
MONITORIQ_LISTEN=0.0.0.0:8080

# Public URL (used in status page links), e.g. https://status.example.com
MONITORIQ_BASE_URL=

# true when running behind a reverse proxy that sets X-Forwarded-For/Proto
MONITORIQ_TRUST_PROXY=false

# HTTPS-only cookies (enabled automatically when BASE_URL starts with https://)
#MONITORIQ_COOKIE_SECURE=true

# Maximum number of concurrent checks
MONITORIQ_MAX_CONCURRENCY=50

# 1 to log every HTTP request to the journal
#MONITORIQ_DEBUG=1
