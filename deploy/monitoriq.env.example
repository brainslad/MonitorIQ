# /etc/monitoriq/monitoriq.env — configuração do MonitorIQ
# Após alterar: systemctl restart monitoriq

# Ligação ao PostgreSQL
MONITORIQ_DATABASE_URL=postgres://monitoriq:ALTERAR@127.0.0.1:5432/monitoriq?sslmode=disable

# Endereço e porta onde o servidor web escuta.
# Use 127.0.0.1:8080 quando estiver atrás de um reverse proxy (nginx).
MONITORIQ_LISTEN=0.0.0.0:8080

# URL público (usado nos links das status pages). Ex.: https://status.exemplo.pt
MONITORIQ_BASE_URL=

# true quando estiver atrás de um reverse proxy que define X-Forwarded-For/Proto
MONITORIQ_TRUST_PROXY=false

# Cookies só por HTTPS (ativado automaticamente se BASE_URL começar por https://)
#MONITORIQ_COOKIE_SECURE=true

# Número máximo de verificações em simultâneo
MONITORIQ_MAX_CONCURRENCY=50

# 1 para registar cada pedido HTTP no journal
#MONITORIQ_DEBUG=1
